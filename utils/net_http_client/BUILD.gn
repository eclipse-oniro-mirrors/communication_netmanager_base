import("//build/ohos.gni")
import("//foundation/communication/netmanager_base/netmanager_base_config.gni")

config("net_http_client_config") {
  include_dirs = [ "include" ]
}

ohos_shared_library("net_http_client") {
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  branch_protector_ret = "pac_ret"

  cflags = common_cflags
  cflags_cc = common_cflags

  sources = [
    "src/http_easy_handle.cpp",
    "src/http_engine.cpp",
    "src/net_http_client.cpp",
  ]

  version_script = "libnet_http_client.map"

  public_configs = [ ":net_http_client_config" ]

  configs = [ "$NETMANAGER_BASE_ROOT/utils:netmanager_base_log_config" ]

  defines = [ "NETMGR_LOG_TAG = \"NetHttpClient\"" ]

  external_deps = [
    "curl:curl_shared",
    "hilog:libhilog",
  ]

  innerapi_tags = [ "platformsdk" ]
  part_name = "netmanager_base"
  subsystem_name = "communication"
}
