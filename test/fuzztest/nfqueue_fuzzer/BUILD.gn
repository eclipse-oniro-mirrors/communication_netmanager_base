import("//build/config/features.gni")

#####################hydra-fuzz###################
import("//build/test.gni")
import("//foundation/communication/netmanager_base/netmanager_base_config.gni")

##############################fuzztest##########################################
ohos_fuzztest("NfQueueFuzzTest") {
  module_out_path = fuzz_test_path
  fuzz_config_file = "$NETMANAGER_BASE_ROOT/test/fuzztest/nfqueue_fuzzer"
  _cfi_blocklist_path = "$NETMANAGER_BASE_ROOT/test/fuzztest/nfqueue_fuzzer/cfi_blocklist.txt"

  include_dirs = [
    "$INNERKITS_ROOT/netmanagernative/include",
    "$NETSYSNATIVE_SOURCE_DIR/include",
    "$NETSYSNATIVE_SOURCE_DIR/include/netsys",
    "$NETMANAGERNATIVE_ROOT/include",
    "$NETMANAGER_BASE_ROOT/test/netmanagernative/unittest/netsys_manager_test",
  ]

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-flto",
    "-fvisibility=hidden",
  ]

  ldflags = [ "-flto" ]

  sources = [
    "$NETMANAGER_BASE_ROOT/test/commonduplicatedcode/common_mock_netmanager_permission.cpp",
    "nf_queue_fuzzer.cpp",
  ]

  deps = [
    "$NETMANAGER_BASE_ROOT/services/netmanagernative:netsys_native_manager_static",
    "$INNERKITS_ROOT/netmanagernative:net_native_manager_if",
    "$NETMANAGER_BASE_ROOT/utils:net_manager_common",
  ]

  defines = [
    "HI_LOG_ENABLE",
    "DH_LOG_TAG=\"NfQueueFuzzTest\"",
    "LOG_DOMAIN=0xD004100",
  ]

  if (netmanager_base_enable_feature_net_firewall) {
    defines += [ "FEATURE_NET_FIREWALL_ENABLE" ]
  }

  external_deps = [
    "bundle_framework:appexecfwk_base",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
  ]
}

###############################################################################
group("fuzztest") {
  testonly = true

  deps = [ ":NfQueueFuzzTest" ]
}

###############################################################################
