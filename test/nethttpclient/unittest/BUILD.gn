import("//build/test.gni")
import("//foundation/communication/netmanager_base/netmanager_base_config.gni")

ohos_unittest("net_http_client_test") {
  module_out_path = "netmanager_base/netmanager_base/net_http_client_test"

  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  branch_protector_ret = "pac_ret"

  sources = [ "net_http_client_test.cpp" ]

  include_dirs = [
    "$NETMANAGER_BASE_ROOT/utils/net_http_client/include",
    "$NETMANAGER_BASE_ROOT/utils/net_http_client/src",
  ]

  deps = [ "$NETMANAGER_BASE_ROOT/utils/net_http_client:net_http_client" ]

  external_deps = [
    "hilog:libhilog",
    "curl:curl_shared",
  ]

  part_name = "netmanager_base"
  subsystem_name = "communication"
}

group("unittest") {
  testonly = true
  deps = [ ":net_http_client_test" ]
}
